# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your-secret-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis Cache (optional — falls back to in-memory + file cache)
UPSTASH_REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token

# Site URL (optional — auto-detects from request Host header)
BASE_URL=https://your-domain.com

# Allowed CORS origins (comma-separated, required in production)
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# Cron secret (optional — secures /api/prewarm)
CRON_SECRET=your-cron-secret

# Error Reporting (optional — sends to this Discord webhook URL)
ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id

# Admin OTP email (optional — uses Gmail by default)
PURCHASE_EMAIL_USER=your-email@gmail.com
PURCHASE_EMAIL_PASS=your-app-password

# Port (optional — defaults to 5000)
PORT=5000
