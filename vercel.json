{
  "version": 2,
  "buildCommand": "cd server && npx tsc",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/migrations/*.sql",
      "maxDuration": 30
    }
  },
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "client/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/prewarm",
      "schedule": "0 0 */3 * *"
    }
  ]
}
